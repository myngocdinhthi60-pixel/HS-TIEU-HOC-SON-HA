# GEMINI_API_KEY: Optional, unused unless AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# Session & Security Secrets (generate strong random 32+ char strings in staging/production)
SESSION_SECRET="dev-local-session-secret-change-in-production"
PIN_PEPPER="dev-local-pin-pepper-change-in-production"

# Firebase Project & Emulator Configuration
FIREBASE_PROJECT_ID="phong-thuc-hanh-tin-hoc-dev"
FIREBASE_DATABASE_URL="http://127.0.0.1:9000/?ns=phong-thuc-hanh-tin-hoc-dev-default-rtdb"

# Uncomment when running Firebase Emulator Suite (firebase emulators:start)
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# FIREBASE_DATABASE_EMULATOR_HOST="127.0.0.1:9000"

# Production / Staging Firebase Service Account (keep server-side only, never expose to client)
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Client Firebase Web SDK Config (optional if using Firebase Auth Client SDK directly)
VITE_FIREBASE_API_KEY="demo-api-key"
VITE_FIREBASE_AUTH_DOMAIN="phong-thuc-hanh-tin-hoc-dev.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="phong-thuc-hanh-tin-hoc-dev"
VITE_FIREBASE_USE_EMULATOR="true"

# Local persistent emulator-compatible store fallback when Java/Firebase Emulator Suite is not running
ALLOW_LOCAL_STORE_FALLBACK="true"
